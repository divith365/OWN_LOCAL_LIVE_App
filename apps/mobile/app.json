{
  "expo": {
    "name": "OWNLOCAL LIVE",
    "slug": "ownlocal-live",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "ownlocallive",
    "splash": {
      "backgroundColor": "#059669"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ownlocal.live",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "OWNLOCAL LIVE needs your location to discover local stores and track deliveries in Ilkal."
      }
    },
    "android": {
      "package": "com.ownlocal.live",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "OWNLOCAL LIVE needs your location to discover local stores and track deliveries in Ilkal."
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "b051aad0-f159-4dfd-a1c4-48041f299458"
      }
    },
    "owner": "arunuvce"
  }
}
